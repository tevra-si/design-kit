{
  "version": 1,
  "baseURL": "http://127.0.0.1:4175",
  "permittedOrigins": [
    "http://127.0.0.1:4175"
  ],
  "viewports": [
    {
      "name": "mobile",
      "width": 390,
      "height": 844
    },
    {
      "name": "tablet",
      "width": 768,
      "height": 1024
    },
    {
      "name": "laptop",
      "width": 1280,
      "height": 800
    },
    {
      "name": "desktop",
      "width": 1440,
      "height": 900
    }
  ],
  "routes": [
    {
      "name": "workspace",
      "path": "/",
      "states": [
        {
          "name": "default",
          "actions": [
            {
              "type": "expect-visible",
              "selector": "#dashboard"
            }
          ],
          "masks": []
        },
        {
          "name": "pricing",
          "actions": [
            {
              "type": "click",
              "selector": "[data-plan=\"starter\"]"
            },
            {
              "type": "expect-visible",
              "selector": "#plan-dialog"
            },
            {
              "type": "press",
              "selector": "#dialog-close",
              "value": "Escape"
            },
            {
              "type": "expect-hidden",
              "selector": "#plan-dialog"
            }
          ],
          "masks": []
        },
        {
          "name": "invalid-form",
          "actions": [
            {
              "type": "click",
              "selector": "#contact-form button"
            },
            {
              "type": "expect-text",
              "selector": "#contact-error",
              "value": "Enter a name"
            }
          ],
          "masks": []
        }
      ]
    }
  ],
  "browser": {},
  "timeoutMs": 15000,
  "thresholds": {
    "diffRatio": 0.01,
    "pixelSensitivity": 0.1,
    "minScore": 75
  },
  "weights": {
    "hierarchy": 15,
    "typography": 10,
    "layout": 15,
    "consistency": 10,
    "responsive": 15,
    "accessibility": 15,
    "interaction": 0,
    "performance": 10,
    "functional": 10
  },
  "requiredChecks": [
    "visual-diff",
    "axe",
    "overflow",
    "functional-tests"
  ],
  "maxRefinements": 2,
  "readySelector": "html[data-tevra-ready=\"true\"]"
}
