{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "createdAt": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    },
    "score": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "hierarchy",
              "typography",
              "layout",
              "consistency",
              "responsive",
              "accessibility",
              "interaction",
              "performance",
              "functional"
            ]
          },
          "kind": {
            "enum": [
              "deterministic",
              "heuristic",
              "ai",
              "human"
            ]
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "unverified"
            ]
          },
          "severity": {
            "enum": [
              "critical",
              "major",
              "minor"
            ]
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 4
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "issue": {
            "type": "string"
          },
          "component": {
            "type": "string"
          },
          "correction": {
            "type": "string"
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^AC-\\d{3,}$"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "category",
          "kind",
          "status",
          "severity",
          "evidence",
          "issue",
          "component",
          "correction"
        ]
      },
      "minItems": 0
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "contextRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "status",
          "checks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-\\d{3,}$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "SKIPPED",
              "BLOCKED",
              "NOT_APPLICABLE"
            ]
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "approvedBy": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "required": [
    "version",
    "createdAt",
    "status",
    "score",
    "blockers",
    "missing",
    "checks",
    "limits",
    "contextRevision"
  ]
}
