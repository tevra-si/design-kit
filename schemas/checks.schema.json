{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "category": {
        "enum": [
          "hierarchy",
          "typography",
          "layout",
          "consistency",
          "responsive",
          "accessibility",
          "interaction",
          "performance",
          "functional"
        ]
      },
      "kind": {
        "enum": [
          "deterministic",
          "heuristic",
          "ai",
          "human"
        ]
      },
      "status": {
        "enum": [
          "passed",
          "failed",
          "unverified"
        ]
      },
      "severity": {
        "enum": [
          "critical",
          "major",
          "minor"
        ]
      },
      "score": {
        "type": "number",
        "minimum": 0,
        "maximum": 4
      },
      "evidence": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 0
      },
      "issue": {
        "type": "string"
      },
      "component": {
        "type": "string"
      },
      "correction": {
        "type": "string"
      }
    },
    "required": [
      "id",
      "category",
      "kind",
      "status",
      "severity",
      "evidence",
      "issue",
      "component",
      "correction"
    ]
  },
  "minItems": 0
}
