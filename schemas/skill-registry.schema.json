{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "skills"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "version",
          "license",
          "entrypoint",
          "capabilities",
          "inputs",
          "outputs",
          "dependencies",
          "conflicts",
          "frameworks",
          "platforms",
          "agents",
          "requiredTools",
          "validation",
          "activation",
          "source",
          "priority",
          "estimatedCost"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "entrypoint": {
            "type": "string",
            "minLength": 1
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "conflicts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "frameworks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "platforms": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "agents": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "requiredTools": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "validation": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "activation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "intents"
            ],
            "properties": {
              "intents": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "references"
            ],
            "properties": {
              "type": {
                "enum": [
                  "original",
                  "inspiration",
                  "adapted",
                  "vendored",
                  "dependency",
                  "integration",
                  "composed"
                ]
              },
              "references": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "estimatedCost": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "minutes",
              "contextTokens"
            ],
            "properties": {
              "minutes": {
                "type": "number",
                "minimum": 0
              },
              "contextTokens": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}
