{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "direction",
              "tokens",
              "convention",
              "rejected",
              "redesign",
              "constraint",
              "regression"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "approved": {
            "type": "boolean"
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "updatedAt": {
            "type": "string",
            "minLength": 1,
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "kind",
          "text",
          "approved",
          "owner",
          "updatedAt"
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "version",
    "revision",
    "entries"
  ]
}
