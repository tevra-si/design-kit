{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "capabilities"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "primary",
          "supporting",
          "stage",
          "constraints",
          "validation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "primary": {
            "type": [
              "string",
              "null"
            ]
          },
          "supporting": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "stage": {
            "type": "integer",
            "minimum": 1
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "validation": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
