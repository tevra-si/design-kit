{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "source",
    "name",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "version",
        "rule",
        "risk"
      ],
      "properties": {
        "tool": {
          "const": "tevra-design-kit"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "rule": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "risk": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      }
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "dependsOn",
          "suggestedSkillIds",
          "reason"
        ],
        "properties": {
          "id": {
            "enum": [
              "plan",
              "develop",
              "review"
            ]
          },
          "kind": {
            "enum": [
              "plan",
              "develop",
              "review"
            ]
          },
          "dependsOn": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "enum": [
                "plan",
                "develop"
              ]
            },
            "uniqueItems": true
          },
          "suggestedSkillIds": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "pattern": "^tevra-[a-z][a-z0-9-]{0,63}$"
            },
            "uniqueItems": true
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        }
      }
    },
    "acceptance": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
